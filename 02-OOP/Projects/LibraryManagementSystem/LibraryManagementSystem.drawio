      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="LIBRARY MANAGEMENT SYSTEM — CLASS DIAGRAM" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#102a43;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="1450" height="45" as="geometry"/></mxCell><mxCell id="User" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px 2px&quot;&gt;«abstract» User&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ Name: string&lt;br/&gt;+ DisplayBooks(Library): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f1fb;strokeColor=#3973a8;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="115" width="300" height="140" as="geometry"/></mxCell><mxCell id="Librarian" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px 2px&quot;&gt;Librarian&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ EmployeeNumber: int&lt;br/&gt;+ AddBook(Book, Library): void&lt;br/&gt;+ RemoveBook(Book, Library): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="95" y="390" width="330" height="145" as="geometry"/></mxCell><mxCell id="LibraryUser" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px 2px&quot;&gt;LibraryUser&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ card: LibraryCard&lt;br/&gt;+ BorrowBook(Book, Library): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="535" y="395" width="340" height=