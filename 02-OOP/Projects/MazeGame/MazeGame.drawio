<mxfile host="app.diagrams.net" agent="ChatGPT" version="24.7.17">
 <diagram id="maze-architecture-v2" name="Maze Game UML and Flow">
  <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
   <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MAZE GAME — CLASS &amp; MOVEMENT DIAGRAM" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#102a43;align=left;" vertex="1" parent="1"><mxGeometry x="65" y="30" width="1480" height="48" as="geometry"/></mxCell><mxCell id="Program" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Program&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ Main(): void&lt;br/&gt;Creates MAZE(40, 20)&lt;br/&gt;Loop: Drawmaze → MovePlayer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="260" height="115" as="geometry"/></mxCell><mxCell id="Maze" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;MAZE&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- _Width: int&lt;br/&gt;- _Height: int&lt;br/&gt;- _Charachter: Charachter&lt;br/&gt;- _MazeobjectsArray: IMazeobject[,]&lt;br/&gt;+ MAZE(width, height)&lt;br/&gt;+ Drawmaze(): void&lt;br/&gt;+ MovePlayer(): void&lt;br/&gt;- UpdatePlayer(dx, dy): void&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e9e8ff;strokeColor=#6458b5;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="570" y="115" width="380" height="225" as="geometry"/></mxCell><mxCell id="Interface" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;«interface» IMazeobject&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ Icon: char&lt;br/&gt;+ IsSold: bool&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f1fb;strokeColor=#3973a8;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="300" height="130" as="geometry"/></mxCell><mxCell id="Character" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Charachter&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ Icon: '@'&lt;br/&gt; + IsSold: true&lt;br/&gt;+ X: int&lt;br/&gt;+ Y: int&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="300" height="145" as="geometry"/></mxCell><mxCell id="Wall" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Wall&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ Icon: '#'&lt;br/&gt;+ IsSold: true&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fce9e9;strokeColor=#c15454;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="570" y="430" width="280" height="120" as="geometry"/></mxCell><mxCell id="Empty" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Empty_space&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ Icon: ' '&lt;br/&gt;+ IsSold: false&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff4dc;strokeColor=#be851e;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="1030" y="430" width="300" height="120" as="geometry"/></mxCell><mxCell id="Flow" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:6px&quot;&gt;How movement works&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;1. Program calls Drawmaze() first, which fills the 2D grid with Wall or Empty_space objects.&lt;br/&gt;2. Arrow keys map to (dx, dy); UpdatePlayer calculates the destination X/Y.&lt;br/&gt;3. A move is accepted only when it is inside the grid and the destination cell has IsSold == false.&lt;br/&gt;4. After a valid move, the player coordinates change and Drawmaze() displays the new position.&lt;br/&gt;Note: the current code draws an exit opening but does not detect a win or stop the game.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="80" y="675" width="1420" height="150" as="geometry"/></mxCell><mxCell id="program-maze" value="creates MAZE(40,20); calls Drawmaze / MovePlayer" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#45647f;dashed=1;endArrow=open;endFill=0;html=1;rounded=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="Program" target="Maze"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="190"/><mxPoint x="480" y="190"/></Array></mxGeometry></mxCell><mxCell id="maze-char" value="owns player reference and X/Y state" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#45647f;startArrow=diamond;startFill=0;endArrow=none;html=1;rounded=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="Maze" target="Character"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="350"/><mxPoint x="220" y="350"/></Array></mxGeometry></mxCell><mxCell id="maze-interface" value="stores IMazeobject[,] grid" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#45647f;startArrow=diamond;startFill=0;endArrow=none;html=1;rounded=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="Maze" target="Interface"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="250"/><mxPoint x="1120" y="250"/></Array></mxGeometry></mxCell><mxCell id="char-implements" value="implements Icon / IsSold" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#45647f;dashed=1;endArrow=block;endFill=0;html=1;rounded=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="Character" target="Interface"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="490"/><mxPoint x="1120" y="490"/><mxPoint x="1120" y="300"/></Array></mxGeometry></mxCell><mxCell id="wall-implements" value="implements obstacle cell" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#45647f;dashed=1;endArrow=block;endFill=0;html=1;rounded=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="Wall" target="Interface"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="475"/><mxPoint x="1120" y="475"/><mxPoint x="1120" y="300"/></Array></mxGeometry></mxCell><mxCell id="empty-implements" value="implements walkable cell" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeWidth=2;strokeColor=#45647f;dashed=1;endArrow=block;endFill=0;html=1;rounded=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="Empty" target="Interface"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="410"/><mxPoint x="1350" y="330"/></Array></mxGeometry></mxCell></root>
  </mxGraphModel>
