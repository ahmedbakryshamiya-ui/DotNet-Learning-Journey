<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="ChatGPT" version="24.7.17">
  <diagram id="inventory-management-flow" name="INVENTORY MANAGEMENT — PROCESS FLOW">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="INVENTORY MANAGEMENT — PROCESS FLOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#102a43;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="1500" height="48" as="geometry"/></mxCell><mxCell id="menu" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Main Menu&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;1. Add product&lt;br/&gt;2. Update product&lt;br/&gt;3. View product&lt;br/&gt;4. Exit&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f1fb;strokeColor=#3973a8;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="230" height="155" as="geometry"/></mxCell><mxCell id="add" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Addproduct()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Read name, quantity, price&lt;br/&gt;Write next inventory row&lt;br/&gt;productCount++&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="320" height="150" as="geometry"/></mxCell><mxCell id="update" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;UpdateProduct()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Search exact product name&lt;br/&gt;If found: update quantity&lt;br/&gt;Otherwise: product not found&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff4dc;strokeColor=#be851e;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="410" y="285" width="320" height="155" as="geometry"/></mxCell><mxCell id="view" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;ViewProduct()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Loop from 0 to productCount&lt;br/&gt;Display name, quantity, and price&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e9e8ff;strokeColor=#6458b5;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="410" y="500" width="320" height="125" as="geometry"/></mxCell><mxCell id="store" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Inventory Array&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;string[50, 3]&lt;br/&gt;Column 0: product name&lt;br/&gt;Column 1: quantity&lt;br/&gt;Column 2: price&lt;br/&gt;productCount tracks used rows&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fce9e9;strokeColor=#c15454;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="360" height="190" as="geometry"/></mxCell><mxCell id="exit" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Exit&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Environment.Exit(0)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="1350" y="265" width="170" height="100" as="geometry"/></mxCell><mxCell id="m-a" value="choice 1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="menu" target="add"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-u" value="choice 2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="menu" target="update"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-v" value="choice 3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="menu" target="view"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-e" value="choice 4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="menu" target="exit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-s" value="write new row" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="add" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u-s" value="update quantity cell" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="update" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-v" value="read stored rows" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="store" target="view"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>
