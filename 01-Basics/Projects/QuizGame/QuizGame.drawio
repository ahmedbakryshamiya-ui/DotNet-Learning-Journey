<mxfile host="app.diagrams.net" agent="ChatGPT" version="24.7.17">
  <diagram id="A fixed question/answer pair is checked with exact string equality; the final score counts correct answers." name="QUIZ GAME — PROCESS FLOW">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="QUIZ GAME — PROCESS FLOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#102a43;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="1500" height="48" as="geometry"/></mxCell><mxCell id="data" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Questions &amp;amp; Answers&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;string[] questions&lt;br/&gt;string[] answers&lt;br/&gt;CorrectAnswer = 0&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f1fb;strokeColor=#3973a8;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="280" height="160" as="geometry"/></mxCell><mxCell id="loop" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;for Loop&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Ask questions[i]&lt;br/&gt;Read userAnswer&lt;br/&gt;Repeat for each question&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="250" height="130" as="geometry"/></mxCell><mxCell id="check" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;IsTheAnswerCorrect()&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Empty input → throw Exception&lt;br/&gt;Otherwise compare exact strings&lt;br/&gt;Case-sensitive comparison&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e9e8ff;strokeColor=#6458b5;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="860" y="175" width="330" height="160" as="geometry"/></mxCell><mxCell id="correct" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Correct Answer&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Print Correct answer&lt;br/&gt;CorrectAnswer++&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="260" height="115" as="geometry"/></mxCell><mxCell id="incorrect" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Incorrect / Empty&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Show expected answer&lt;br/&gt;or caught exception message&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff4dc;strokeColor=#be851e;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="1190" y="440" width="300" height="115" as="geometry"/></mxCell><mxCell id="score" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Final Score&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Print CorrectAnswer / questions.Length&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fce9e9;strokeColor=#c15454;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="330" height="105" as="geometry"/></mxCell><mxCell id="d-l" value="question + answer arrays" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="data" target="loop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l-c" value="user answer + expected answer" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="loop" target="check"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-ok" value="true" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="check" target="correct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-bad" value="false or exception" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="check" target="incorrect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ok-score" value="after all questions" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="correct" target="score"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bad-score" value="continue quiz" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="incorrect" target="score"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>
