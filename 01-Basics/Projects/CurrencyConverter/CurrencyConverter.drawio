<mxfile host="app.diagrams.net" agent="ChatGPT" version="24.7.17">
  <diagram id="Two switch statements convert from source currency to EGP, then from EGP to target currency." name="CURRENCY CONVERSION — PROCESS FLOW">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CURRENCY CONVERSION — PROCESS FLOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#102a43;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="1500" height="48" as="geometry"/></mxCell><mxCell id="input" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;User Input&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;From currency: 1–4&lt;br/&gt;To currency: 1–4&lt;br/&gt;Amount: double&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f1fb;strokeColor=#3973a8;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="260" height="140" as="geometry"/></mxCell><mxCell id="rates" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Fixed Rates&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;USD = 48.5 EGP&lt;br/&gt;EUR = 52.0 EGP&lt;br/&gt;GBP = 60.0 EGP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff4dc;strokeColor=#be851e;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="260" height="150" as="geometry"/></mxCell><mxCell id="source" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Convert Source to EGP&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;switch(from)&lt;br/&gt;EGP = amount × source rate&lt;br/&gt;Invalid choice → message + return&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e7f6ef;strokeColor=#24835b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="500" y="165" width="330" height="150" as="geometry"/></mxCell><mxCell id="target" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Convert EGP to Target&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;switch(to)&lt;br/&gt;result = EGP ÷ target rate&lt;br/&gt;Invalid choice → message + return&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e9e8ff;strokeColor=#6458b5;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="990" y="165" width="340" height="150" as="geometry"/></mxCell><mxCell id="result" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Display Result&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;Print converted amount&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fce9e9;strokeColor=#c15454;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="1370" y="190" width="190" height="100" as="geometry"/></mxCell><mxCell id="note" value="&lt;div style=&quot;font-size:17px;font-weight:bold;text-align:center;padding:6px&quot;&gt;Conversion Formula&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;All conversions pass through EGP as the base currency.&lt;br/&gt;Rates are hard-coded example values; they are not refreshed from a live service.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontColor=#172033;shadow=1;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="830" height="120" as="geometry"/></mxCell><mxCell id="i-s" value="provides choices + amount" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="input" target="source"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-s" value="source currency rate" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="rates" target="source"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s-t" value="amountInEGP" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="source" target="target"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-t" value="target currency rate" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="rates" target="target"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-o" value="calculated result" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=1;html=1;strokeWidth=2;strokeColor=#45647f;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;align=center;verticalAlign=middle;" edge="1" parent="1" source="target" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>
    </mxGraphModel>
